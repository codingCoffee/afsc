IMGPROXY_USE_S3="true"
IMGPROXY_S3_ENDPOINT=http://rustfs:9000
IMGPROXY_S3_ENDPOINT_USE_PATH_STYLE="true"
IMGPROXY_S3_REGION=us-east-1
IMGPROXY_ALLOWED_SOURCES=s3://afsc/
IMGPROXY_STRIP_METADATA="true"
IMGPROXY_MAX_SRC_RESOLUTION="50"
IMGPROXY_MAX_ANIMATION_FRAMES="200"
# Copy to .imgproxy.env (gitignored). Generate key and salt with: openssl rand -hex 32
# They must match AFSC_IMGPROXY_KEY and AFSC_IMGPROXY_SALT in app/.env.
IMGPROXY_KEY=CHANGE_ME_hex
IMGPROXY_SALT=CHANGE_ME_hex
# Read-only credentials (s3:GetObject on the media bucket only). In local dev, a RustFS user with a read-only policy.
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
