AFSC_API_HOST=0.0.0.0
AFSC_API_PORT=1381
AFSC_DATABASE_URL=postgres://afsc:CHANGE_ME@postgres:5432/afsc?sslmode=disable
# generate with: openssl rand -base64 48
AFSC_JWT_SECRET=CHANGE_ME_to_a_random_string_of_at_least_32_bytes
AFSC_ACCESS_TOKEN_EXPIRY_MINS=5
AFSC_REFRESH_TOKEN_EXPIRY_DAYS=7

AFSC_THEME_DIR=themes/default
# origin for absolute URLs (feeds, canonical links); never taken from the Host header
AFSC_PUBLIC_BASE_URL=http://localhost:1381
# in-process page cache size per replica; 0 disables it
AFSC_PAGE_CACHE_MB=128

# S3 credentials come from the default AWS chain (IAM role in prod); never commit static keys.
AFSC_S3_BUCKET=afsc-media
AFSC_S3_REGION=us-east-1
# only for S3-compatible servers in local dev; leave empty for AWS
AFSC_S3_ENDPOINT=http://rustfs:9000
AFSC_S3_PATH_STYLE=true
# local dev only: the RustFS access/secret keys from .rustfs.env
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME

# imgproxy on the private network only; never expose it publicly. Key and salt must match .imgproxy.env.
# generate each with: openssl rand -hex 32
AFSC_IMGPROXY_URL=http://imgproxy:8080
AFSC_IMGPROXY_KEY=CHANGE_ME_hex
AFSC_IMGPROXY_SALT=CHANGE_ME_hex
